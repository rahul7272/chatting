# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/academy_db

# Authentication Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production_123456!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_abcdef!
JWT_REFRESH_EXPIRES_IN=30d

# Client URLs (CORS)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# Firebase Cloud Messaging (FCM)
FIREBASE_SERVICE_ACCOUNT_KEY=./config/firebaseServiceAccount.json

# Socket.IO Config
SOCKET_PORT=5000
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
